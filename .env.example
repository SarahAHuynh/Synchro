# Copy to .env.local. Never commit real credentials.
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Optional: enables AI-curated activity recommendations. Keep this server-only.
OPENAI_API_KEY=

# Optional when deployed: authorize /api/calendar/sync for scheduled retries.
# Generate a separate value with: openssl rand -hex 32
CRON_SECRET=
